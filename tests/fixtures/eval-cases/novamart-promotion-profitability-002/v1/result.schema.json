{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovaMart promotion profitability result",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "promotion_results", "final_answer", "methodology", "artifacts"],
  "properties": {
    "case_id": {"const": "novamart-promotion-profitability-002"},
    "promotion_results": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["promo_name", "start_date", "end_date", "promo_days", "completed_order_count", "discounted_merchandise_value", "merchandise_cost", "merchandise_gross_profit", "gross_profit_per_day"],
        "properties": {
          "promo_name": {"enum": ["Black Friday", "Holiday Sale"]},
          "start_date": {"type": "string", "minLength": 10},
          "end_date": {"type": "string", "minLength": 10},
          "promo_days": {"type": "integer", "minimum": 1},
          "completed_order_count": {"type": "integer", "minimum": 0},
          "discounted_merchandise_value": {"type": "number"},
          "merchandise_cost": {"type": "number"},
          "merchandise_gross_profit": {"type": "number"},
          "gross_profit_per_day": {"type": "number"}
        }
      }
    },
    "final_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "recommended_next_step", "supporting_facts", "important_limitation"],
      "properties": {
        "conclusion": {"type": "string", "minLength": 1},
        "recommended_next_step": {"type": "string", "minLength": 1},
        "supporting_facts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "important_limitation": {"type": "string", "minLength": 1}
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_type", "population", "grain", "joins", "calculation_summary", "validation_checks", "assumptions"],
      "properties": {
        "analysis_type": {"const": "descriptive"},
        "population": {"type": "string", "minLength": 1},
        "grain": {"type": "string", "minLength": 1},
        "joins": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "calculation_summary": {"type": "string", "minLength": 1},
        "validation_checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_results", "brief", "chart", "chart_data", "calculation"],
      "properties": {
        "promotion_results": {"const": "promotion-results.csv"},
        "brief": {"const": "brief.md"},
        "chart": {"const": "chart.png"},
        "chart_data": {"const": "chart-data.csv"},
        "calculation": {"const": "calculation.sql"}
      }
    }
  }
}
