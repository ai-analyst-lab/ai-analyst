# Connection Template: Snowflake
# Copy to .knowledge/datasets/{name}/manifest.yaml and fill in values.
# Requires: pip install snowflake-connector-python
# Auth: programmatic access token (recommended for agents) or password.

dataset_id: "{dataset_id}"
display_name: "{Display Name}"
description: "{Brief description of the dataset}"
domain: "{e-commerce|saas|fintech|marketplace|other}"
created_at: "{YYYY-MM-DD}"
is_seed: false

connection:
  type: snowflake
  authenticator: programmatic_access_token
  account: "{account_identifier}"   # e.g., xy12345.us-east-1
  warehouse: "{warehouse}"
  database: "{database}"
  schema: "public"
  user: "{username}"
  token: "$SNOWFLAKE_TOKEN"         # Secret belongs in .env, never in this manifest

  # Legacy password authentication remains supported for accounts that allow it.
  # Replace the two lines above with:
  # authenticator: password
  # password: "$SNOWFLAKE_PASSWORD"

summary:
  table_count: null
  total_rows: null
  date_range: null
  primary_entities: []
  key_dimensions: []
  last_profiled: null

local_data:
  path: null
  duckdb: null

status: active
last_used: null
analysis_count: 0
