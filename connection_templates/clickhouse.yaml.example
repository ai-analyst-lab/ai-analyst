# Connection Template: ClickHouse (via MCP)
# Copy to .knowledge/datasets/{name}/manifest.yaml and fill in values.

dataset_id: "{dataset_id}"
display_name: "{Display Name}"
description: "{Brief description of the dataset}"
domain: "{payments|fintech|e-commerce|saas|marketplace|other}"
created_at: "{YYYY-MM-DD}"
is_seed: false

connection:
  type: clickhouse
  database: "{database}"
  schema: "{schema}"     # SQL schema prefix for queries (optional)

summary:
  table_count: null      # Auto-populated by data profiler
  total_rows: null
  date_range: null
  primary_entities: []
  key_dimensions: []
  last_profiled: null

local_data:
  path: null               # Optional CSV fallback directory

status: active
last_used: null
analysis_count: 0
